{
  "name": "spectre-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "effect-tsgo patch --oxlint",
    "postinstall": "patch-package",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --dry-run",
    "build:wasm": "cd crates/spectre-sync && CC_wasm32_unknown_unknown=/opt/homebrew/opt/llvm@21/bin/clang AR_wasm32_unknown_unknown=/opt/homebrew/opt/llvm@21/bin/llvm-ar cargo build --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir wasm-out target/wasm32-unknown-unknown/release/spectre_sync.wasm && wasm-opt --enable-nontrapping-float-to-int --enable-bulk-memory -O2 -o wasm-out/spectre_sync_bg.wasm wasm-out/spectre_sync_bg.wasm && cd ../.. && cp crates/spectre-sync/wasm-out/spectre_sync.js crates/spectre-sync/wasm-out/spectre_sync.d.ts crates/spectre-sync/wasm-out/spectre_sync_bg.wasm src/lib/spike/"
  },
  "dependencies": {
    "@kobalte/core": "^2.0.0-alpha.0",
    "@solidjs/router": "^2.0.0-next.16",
    "@solidjs/web": "^2.0.0-rc.0",
    "@stablelib/scrypt": "^2.0.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "effect": "^4.0.0-beta.107",
    "jsqr": "^1.4.0",
    "solid-js": "^2.0.0-rc.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@effect/tsgo": "^0.36.4",
    "@solidjs/testing-library": "^1.0.0-beta.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "0.14.5",
    "knip": "^6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-oxlint": "^2.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^3.0.0-next.27",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
